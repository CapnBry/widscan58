# Widscan58 display (ESP32 CYD). GPL-3.0-or-later.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# LVGL 8.3 (src/idf_component.yml)
CONFIG_LV_COLOR_DEPTH_16=y
# The panel takes RGB565 high byte first.
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEMCPY_MEMSET_STD=y
CONFIG_LV_DISP_DEF_REFR_PERIOD=10
CONFIG_LV_INDEV_DEF_READ_PERIOD=10
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_THEME_DEFAULT_DARK=y
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
# RemoteID receiver (src/rid_radio.c): Wi-Fi promiscuous mode and a BLE
# passive scan straight to the controller (VHCI, no host stack), one at a
# time. Off, both are deinitialized.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_HCI_MODE_VHCI=y
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
# CONFIG_ESP_WIFI_SOFTAP_SUPPORT is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_SAE is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set
# IRAM: without these the image overflows it (LVGL's drawing is there).
# Only management frames are taken, a few per second.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_EXTRA_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP_WIFI_SLP_IRAM_OPT is not set
# The ring buffers (UART drivers, whose interrupt handlers are in flash
# anyway) in flash too: ~4 KB of IRAM.
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
# Advertising reports unthrottled: there is no host stack to hand the
# controller its flow control credits back.
# CONFIG_BTDM_BLE_ADV_REPORT_FLOW_CTRL_SUPP is not set
# No duplicate filter (the scan asks for every report) and no scanning
# while connected: memory.
# CONFIG_BTDM_BLE_SCAN_DUPL is not set
# CONFIG_BTDM_CTRL_FULL_SCAN_SUPPORTED is not set
# The receiver never joins a network: no enterprise (EAP/TLS), GMAC,
# ESP-NOW keys, Wi-Fi settings in NVS, or power saving while disconnected;
# the fewest management short buffers.
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set
# CONFIG_ESP_WIFI_MBEDTLS_TLS_CLIENT is not set
# CONFIG_ESP_WIFI_GMAC_SUPPORT is not set
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=0
# CONFIG_ESP_WIFI_NVS_ENABLED is not set
# CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE is not set
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=6
# Scanning only: no channel assessment or LE ping (connection features), no
# modem sleep (it never idles while on), and the controller's interrupt at
# an ordinary level: the level 4 one needs its own 4.4 KB stack in .data.
# CONFIG_BTDM_BLE_CHAN_ASS_EN is not set
# CONFIG_BTDM_BLE_PING_EN is not set
# CONFIG_BTDM_CTRL_MODEM_SLEEP is not set
# CONFIG_BTDM_CTRL_HLI is not set
# Promiscuous management frames only, a few per second: 2 static RX
# buffers (the least) and 2 for management frames. Nothing handles the
# default event loop's Wi-Fi events: a short queue.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=2
CONFIG_ESP_SYSTEM_EVENT_QUEUE_SIZE=8
